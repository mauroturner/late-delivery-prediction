# Copy this file to .env (git-ignored) and fill the four values. Nothing here is a secret: the values are empty on purpose, and the
# compose file refuses to start while any of them is empty (it has no default for any).
#
# Generate each one with the standard library, for example:
#   python -c "import secrets; print(secrets.token_hex(24))"
# The result is hexadecimal, with no character that needs escaping in the connection string of the database.
# The Fernet key is the one exception: it must be a url-safe base64 text of 32 bytes:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_PASSWORD=
LATEDEL_DB_PASSWORD=
